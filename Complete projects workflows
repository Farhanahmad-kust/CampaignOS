        "jsCode": "// Iterate over all leads\nreturn items.map(item => {\n  const lead = item.json;\n  \n  // Get the phone string (handle nulls)\n  let phone = lead.phone ? lead.phone.toString() : \"\";\n\n  // 1. Remove ALL non-digit characters (spaces, dashes, parens)\n  let digits = phone.replace(/\\D/g, \"\");\n\n  // 2. Format for US Vapi Trial (+1)\n  let formattedPhone = \"\";\n\n  if (digits.length === 10) {\n    // Case: 5551234567 -> +15551234567\n    formattedPhone = \"+1\" + digits;\n  } \n  else if (digits.length === 11 && digits.startsWith(\"1\")) {\n    // Case: 15551234567 -> +15551234567\n    formattedPhone = \"+\" + digits;\n  } \n  else if (digits.length > 0) {\n    // Fallback: If it's weird, just force +1\n    formattedPhone = \"+1\" + digits;\n  }\n\n  // 3. Return the clean number + original data\n  return {\n    json: {\n      ...lead,\n      clean_phone_e164: formattedPhone\n    }\n  };\n});"
      },
