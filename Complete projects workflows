        "jsCode": "// 1. Get Campaign ID\nconst campaignId = $('Campaign_Node').first().json.id;\n\n// 2. Get CSV Rows\nconst csvRows = $('CSV').all(); \n\n// 3. Create the Package\nconst bulkData = csvRows.map(row => ({\n    campaign_id: campaignId,\n    \n    // Standard Contact Info\n    first_name: row.json['first_name'] || row.json['First Name'] || null,\n    last_name: row.json['last_name'] || row.json['Last Name'] || null,\n    email: row.json['email'] || row.json['Email'] || null,\n    phone: row.json['phone'] || row.json['Phone'] || null,\n    \n    // Company Info\n    company_name: row.json['company_name'] || row.json['Company Name'] || \"Unknown\",\n    website: row.json['company_website'] || row.json['website'] || row.json['Company Website'] || null,\n    \n    // CRM Data (Job, LinkedIn, Employees)\n    job_title: row.json['job_title'] || row.json['Job Title'] || null,\n    linkedin_url: row.json['profile_link'] || row.json['LinkedIn'] || row.json['profile_link_public_identifier'] || null,\n    employee_count: row.json['employee_count_end'] || row.json['Employee Count'] || null,\n    \n    // NEW: Address / Location\n    address: row.json['address'] || row.json['Address'] || row.json['Location'] || null\n}));\n\n// 4. Return Payload\nreturn [\n    {\n        json: {\n            payload: bulkData\n        }\n    }\n];"
