      "parameters": {
        "jsCode": "// 1. Get the Saved Data (Input from HTTP Request)\n// The input items ARE the rows returned from Supabase\nconst savedRows = items.map(item => item.json);\n\n// 2. Counters\nlet emailCount = 0;\nlet phoneCount = 0;\nlet missingCount = 0;\nlet reviewList = [];\n\n// 3. Analyze the SAVED data\nsavedRows.forEach(row => {\n    \n    // Check fields\n    const hasEmail = row.email && row.email.includes('@');\n    const hasPhone = row.phone && row.phone.length > 5;\n    \n    // Stats\n    if (hasEmail) emailCount++;\n    if (hasPhone) phoneCount++;\n\n    // Check for Missing Data\n    const isIncomplete = !hasPhone || !row.job_title || !row.website || !row.linkedin_url || row.company_name === \"Unknown\" || !hasEmail;\n\n    if (isIncomplete) {\n        missingCount++;\n        \n        // Add to \"Needs Attention\" List\n        // Limit to 100 for speed\n        if (reviewList.length < 100) {\n            reviewList.push({\n                id: row.id, // <--- CRITICAL: CAPTURING THE ID FROM SUPABASE\n                name: (row.first_name || '') + ' ' + (row.last_name || ''),\n                email: row.email || \"\",\n                phone: row.phone || \"\",\n                company_name: row.company_name || \"\",\n                job_title: row.job_title || \"\",\n                website: row.website || \"\",\n                linkedin_url: row.linkedin_url || \"\"\n            });\n        }\n    }\n});\n\n// 4. Return Final Response for Website\n// We grab the campaign ID from the first row of saved data\nconst campaignId = savedRows.length > 0 ? savedRows[0].campaign_id : null;\n\nreturn [{\n    json: {\n        final_response: {\n            status: \"success\",\n            message: \"Upload complete\",\n            campaign_id: campaignId,\n            stats: {\n                email_leads: emailCount,\n                phone_leads: phoneCount,\n                missing_data: missingCount\n            },\n            review_leads: reviewList // Now includes IDs!\n        }\n    }\n}];"
      },
